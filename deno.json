{
  "tasks": {
    "dev": "deno --allow-all --env-file --watch src/main.ts",
    "deploy": "deno -A tasks/deploy.ts",
    "staging": "deno task deploy staging",
    "prod": "deno task deploy prod",
    "install-remote-deployer": "deno -A tasks/install-remote-deployer.ts",
    "get-simplewebauthn": "deno bundle -o src/features/passkeys/assets/simplewebauthn.js jsr:@simplewebauthn/browser@^14.0.0"
  },
  "unstable": ["kv"],
  "imports": {
    "@shared/": "./src/shared/",
    "@features/": "./src/features/",
    "@middleware/": "./src/middleware/",
    "@std/async": "jsr:@std/async@^1.0.14",
    "@josh-hemphill/maxminddb-wasm": "jsr:@josh-hemphill/maxminddb-wasm@^2.1.8",
    "@simplewebauthn/server": "jsr:@simplewebauthn/server@^14.0.0",
    "@std/collections": "jsr:@std/collections@^1.3.0",
    "@std/datetime": "jsr:@std/datetime@^0.225.7",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/tar": "jsr:@std/tar@^0.1.10",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@std/ulid": "jsr:@std/ulid@^1.0.0",
    "preact": "npm:preact@^10.29.8",
    "preact/compat": "npm:preact@^10.29.8/compat",
    "preact-render-to-string": "npm:preact-render-to-string@^6.7.0",
    "type-fest": "npm:type-fest@^5.8.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "npm:preact"
  },
  "lint": {
    "rules": {
      "exclude": ["jsx-key", "jsx-button-has-type"]
    }
  }
}
