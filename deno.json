{
  "tasks": {
    "dev": "deno --allow-all --env-file --watch src/main.ts",
    "check:src": {
      "command": "deno check src/main.ts",
      "dependencies": ["format:src", "lint:src"]
    },
    "check:tasks": {
      "command": "deno check 'tasks/**/*.ts'",
      "dependencies": ["format:tasks", "lint:tasks"]
    },
    "format:src": "deno fmt --check 'src/**/*.ts' 'src/**/*.tsx'",
    "format:tasks": "deno fmt --check 'tasks/**/*.ts'",
    "lint:src": "deno lint src --ignore='src/**/assets'",
    "lint:tasks": "deno lint tasks",
    "setup": "deno task hooks:install",
    "hooks:install": "git config core.hooksPath .githooks",
    "deploy": "deno -A tasks/deploy/deploy.ts",
    "logs": "deno -A tasks/deploy/logs.ts",
    "publish-deployer": "deno -A tasks/deploy/publish-deployer.ts",
    "publish-installer": "deno -A tasks/setup-remote/publish-installer.ts",
    "setup-remote": "deno -A tasks/setup-remote/setup-remote.ts",
    "set-secret": "deno -A tasks/setup-remote/set-secret.ts",
    "backup-db": "deno -A tasks/backup/backup.ts",
    "backup-config": "deno -A tasks/backup/backup-config.ts",
    "restore-db": "deno -A tasks/backup/restore.ts",
    "restore-config": "deno -A tasks/backup/restore-config.ts",
    "schedule-backup": "deno -A tasks/backup/schedule.ts",
    "get-simplewebauthn": "deno bundle -o src/features/passkeys/assets/simplewebauthn.js jsr:@simplewebauthn/browser@^14.0.0"
  },
  "unstable": ["kv"],
  "imports": {
    "@shared/": "./src/shared/",
    "@features/": "./src/features/",
    "@middleware/": "./src/middleware/",
    "@std/async": "jsr:@std/async@^1.0.14",
    "@josh-hemphill/maxminddb-wasm": "jsr:@josh-hemphill/maxminddb-wasm@^2.1.8",
    "@simplewebauthn/server": "jsr:@simplewebauthn/server@^14.0.0",
    "@std/collections": "jsr:@std/collections@^1.3.0",
    "@std/datetime": "jsr:@std/datetime@^0.225.7",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/tar": "jsr:@std/tar@^0.1.10",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@std/ulid": "jsr:@std/ulid@^1.0.0",
    "preact": "npm:preact@^10.29.8",
    "preact/compat": "npm:preact@^10.29.8/compat",
    "preact-render-to-string": "npm:preact-render-to-string@^6.7.0",
    "type-fest": "npm:type-fest@^5.8.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "npm:preact"
  },
  "lint": {
    "rules": {
      "exclude": ["jsx-key", "jsx-button-has-type"]
    }
  }
}
